<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication4.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="using:AvaloniaApplication4.Views.Pages"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="AvaloniaApplication4.Views.MainWindow"
        Icon="/Assets/download.png"
        Title="AvaloniaQR - QR Code Generator"
        x:DataType="vm:MainWindowViewModel"
        MinWidth="1000" MinHeight="600"
        Background="#F3F3F3">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <!-- Fluent Colors -->
        <SolidColorBrush x:Key="FluentAccent" Color="#0078D4"/>
        <SolidColorBrush x:Key="FluentNavBackground" Color="#F9F9F9"/>
        <SolidColorBrush x:Key="FluentNavHover" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="FluentNavActive" Color="#0078D4"/>
        <SolidColorBrush x:Key="FluentTextPrimary" Color="#000000"/>
        <SolidColorBrush x:Key="FluentTextSecondary" Color="#605E5C"/>
        <SolidColorBrush x:Key="FluentBorderColor" Color="#E1DFDD"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Navigation Item Style -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FluentNavHover}"/>
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#E6F2FA"/>
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource FluentNavActive}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.nav-icon">
            <Setter Property="Foreground" Value="{StaticResource FluentNavActive}"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*">
        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource FluentNavBackground}"
                BorderBrush="{StaticResource FluentBorderColor}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Header -->
                <Border DockPanel.Dock="Top"
                        Padding="16"
                        Margin="0,0,0,12"
                        BorderBrush="{StaticResource FluentBorderColor}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📱" FontSize="32" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AvaloniaQR"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource FluentTextPrimary}"/>
                                <TextBlock Text="QR Generator"
                                           FontSize="11"
                                           Foreground="{StaticResource FluentTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <ListBox x:Name="NavList"
                         Items="{Binding NavigationItems}"
                         SelectedItem="{Binding NavigationItems[0]}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).NavigateToPage}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="20"
                                               VerticalAlignment="Center"
                                               Classes="nav-icon"
                                               Foreground="{StaticResource FluentTextSecondary}"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Classes="nav-label"
                                               Foreground="{StaticResource FluentTextPrimary}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:MainPageViewModel">
                    <pages:MainPage />
                </DataTemplate>
                <DataTemplate DataType="vm:SettingsPageViewModel">
                    <pages:SettingsPage />
                </DataTemplate>
                <DataTemplate DataType="vm:AboutPageViewModel">
                    <pages:AboutPage />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </Grid>
</Window>
