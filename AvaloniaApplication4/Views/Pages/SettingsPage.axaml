<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaApplication4.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="AvaloniaApplication4.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">

    <UserControl.Resources>
        <!-- Fluent Colors -->
        <SolidColorBrush x:Key="FluentAccent" Color="#0078D4"/>
        <SolidColorBrush x:Key="FluentCardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FluentTextPrimary" Color="#000000"/>
        <SolidColorBrush x:Key="FluentTextSecondary" Color="#605E5C"/>
        <SolidColorBrush x:Key="FluentBorderColor" Color="#E1DFDD"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Card Style -->
        <Style Selector="Border.FluentCard">
            <Setter Property="Background" Value="{StaticResource FluentCardBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#10000000"/>
        </Style>

        <!-- TextBox Style -->
        <Style Selector="TextBox.FluentTextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>

        <!-- ComboBox Style -->
        <Style Selector="ComboBox.FluentComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel Spacing="24" MaxWidth="800">
            <!-- Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Settings" FontSize="32" FontWeight="Bold" Foreground="{StaticResource FluentTextPrimary}"/>
                <TextBlock Text="Configure your QR code generation preferences" FontSize="14" Foreground="{StaticResource FluentTextSecondary}"/>
            </StackPanel>

            <!-- General Settings Card -->
            <Border Classes="FluentCard">
                <StackPanel Spacing="20">
                    <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Default Save Location" FontSize="13" FontWeight="Medium" Foreground="{StaticResource FluentTextPrimary}"/>
                        <TextBox Classes="FluentTextBox"
                                 Text="{Binding DefaultSaveLocation, Mode=TwoWay}"
                                 IsReadOnly="True"
                                 Watermark="Select folder..."/>
                        <TextBlock Text="Location where QR codes will be saved by default"
                                   FontSize="12" Foreground="{StaticResource FluentTextSecondary}"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource FluentBorderColor}"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Default File Format" FontSize="13" FontWeight="Medium" Foreground="{StaticResource FluentTextPrimary}"/>
                        <ComboBox Classes="FluentComboBox"
                                  SelectedItem="{Binding DefaultFileFormat, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <x:String>.jpg</x:String>
                            <x:String>.png</x:String>
                            <x:String>.bmp</x:String>
                        </ComboBox>
                        <TextBlock Text="Default file format for saving QR codes"
                                   FontSize="12" Foreground="{StaticResource FluentTextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- QR Code Settings Card -->
            <Border Classes="FluentCard">
                <StackPanel Spacing="20">
                    <TextBlock Text="QR Code" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="QR Code Size (Pixel Module Size)" FontSize="13" FontWeight="Medium" Foreground="{StaticResource FluentTextPrimary}"/>
                        <NumericUpDown Value="{Binding QrCodeSize, Mode=TwoWay}"
                                       Minimum="5"
                                       Maximum="50"
                                       Increment="1"
                                       FormatString="0"
                                       Height="40"/>
                        <TextBlock Text="Higher values create larger, more detailed QR codes"
                                   FontSize="12" Foreground="{StaticResource FluentTextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Auto-Generate Settings Card -->
            <Border Classes="FluentCard">
                <StackPanel Spacing="20">
                    <TextBlock Text="Auto-Generate" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}"/>

                    <StackPanel Spacing="12">
                        <CheckBox IsChecked="{Binding AutoGenerateEnabled, Mode=TwoWay}"
                                  FontSize="14">
                            <TextBlock Text="Enable auto-generate" FontWeight="Medium"/>
                        </CheckBox>
                        <TextBlock Text="Automatically generate QR codes as you type"
                                   FontSize="12" Foreground="{StaticResource FluentTextSecondary}"
                                   Margin="28,0,0,0"/>
                    </StackPanel>

                    <StackPanel Spacing="8" IsEnabled="{Binding AutoGenerateEnabled}">
                        <TextBlock Text="Auto-Generate Delay (seconds)" FontSize="13" FontWeight="Medium" Foreground="{StaticResource FluentTextPrimary}"/>
                        <NumericUpDown Value="{Binding AutoGenerateDelay, Mode=TwoWay}"
                                       Minimum="0.1"
                                       Maximum="5.0"
                                       Increment="0.1"
                                       FormatString="0.0"
                                       Height="40"/>
                        <TextBlock Text="Delay before generating QR code after typing stops"
                                   FontSize="12" Foreground="{StaticResource FluentTextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Info Card -->
            <Border Classes="FluentCard"
                    Background="#F0F6FC"
                    BorderBrush="#0078D4"
                    BorderThickness="1"
                    Padding="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="ℹ️" FontSize="16"/>
                        <TextBlock Text="Note" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FluentAccent}"/>
                    </StackPanel>
                    <TextBlock Text="Settings will be saved automatically and applied on next launch. Some settings may require restarting the application to take effect."
                               FontSize="12" Foreground="{StaticResource FluentTextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
