<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaApplication4.ViewModels"
             xmlns:controls="clr-namespace:Avalonia.Notification.Controls;assembly=Notification.Avalonia"
             xmlns:models="clr-namespace:AvaloniaApplication4.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="AvaloniaApplication4.Views.Pages.MainPage"
             x:DataType="vm:MainPageViewModel">

    <UserControl.Resources>
        <!-- Fluent Colors -->
        <SolidColorBrush x:Key="FluentAccent" Color="#0078D4"/>
        <SolidColorBrush x:Key="FluentSuccess" Color="#107C10"/>
        <SolidColorBrush x:Key="FluentDanger" Color="#E81123"/>
        <SolidColorBrush x:Key="FluentCardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FluentSidebarBackground" Color="#F9F9F9"/>
        <SolidColorBrush x:Key="FluentTextPrimary" Color="#000000"/>
        <SolidColorBrush x:Key="FluentTextSecondary" Color="#605E5C"/>
        <SolidColorBrush x:Key="FluentBorderColor" Color="#E1DFDD"/>

        <!-- Card Style -->
        <ControlTheme x:Key="FluentCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FluentCardBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #15000000"/>
        </ControlTheme>

        <!-- Button Styles -->
        <ControlTheme x:Key="FluentPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FluentAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#1890D6"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="FluentSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource FluentAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#F0F6FC"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="FluentDangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FluentDanger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </ControlTheme>

        <ControlTheme x:Key="FluentSuccessButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FluentSuccess}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </ControlTheme>

        <!-- TextBox Style -->
        <ControlTheme x:Key="FluentTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Style Selector="^:focus">
                <Setter Property="BorderBrush" Value="{StaticResource FluentAccent}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>
        </ControlTheme>

        <!-- ComboBox Style -->
        <ControlTheme x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Notification Overlay -->
        <Border Grid.ColumnSpan="3" ZIndex="1000">
            <controls:NotificationMessageContainer Manager="{CompiledBinding Manager}">
                <controls:NotificationMessageContainer.Styles>
                    <Style Selector="controls|NotificationMessageContainer">
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                </controls:NotificationMessageContainer.Styles>
            </controls:NotificationMessageContainer>
        </Border>

        <!-- Main Content Grid -->
        <Grid ColumnDefinitions="320,*,380">
            <!-- Left Sidebar - Preview Panel -->
            <Border Grid.Column="0"
                    Background="{StaticResource FluentSidebarBackground}"
                    BorderBrush="{StaticResource FluentBorderColor}"
                    BorderThickness="0,0,1,0"
                    Padding="24">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="QR Code Preview"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FluentTextPrimary}"/>
                        <TextBlock Text="Live preview of your QR code"
                                   FontSize="13"
                                   Foreground="{StaticResource FluentTextSecondary}"/>
                    </StackPanel>

                    <Border Theme="{StaticResource FluentCard}" Padding="20" HorizontalAlignment="Center">
                        <Panel>
                            <Border Width="240" Height="240"
                                    Background="#F0F0F0" CornerRadius="8"
                                    IsVisible="{Binding BitmapVal, Converter={x:Static ObjectConverters.IsNull}}">
                                <StackPanel VerticalAlignment="Center" Spacing="12">
                                    <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="No QR Code Yet" FontSize="14" FontWeight="Medium"
                                               HorizontalAlignment="Center" Foreground="{StaticResource FluentTextSecondary}"/>
                                    <TextBlock Text="Enter data to generate" FontSize="12"
                                               HorizontalAlignment="Center" Foreground="{StaticResource FluentTextSecondary}" Opacity="0.7"/>
                                </StackPanel>
                            </Border>
                            <Image Source="{CompiledBinding BitmapVal}" Width="240" Height="240"
                                   Stretch="Uniform" IsVisible="{Binding BitmapVal, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Panel>
                    </Border>

                    <Border Theme="{StaticResource FluentCard}" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="💡 Quick Guide" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}"/>
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="1." FontWeight="SemiBold" Foreground="{StaticResource FluentAccent}"/>
                                    <TextBlock Text="Enter your data" FontSize="13" Foreground="{StaticResource FluentTextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="2." FontWeight="SemiBold" Foreground="{StaticResource FluentAccent}"/>
                                    <TextBlock Text="Set a filename" FontSize="13" Foreground="{StaticResource FluentTextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="3." FontWeight="SemiBold" Foreground="{StaticResource FluentAccent}"/>
                                    <TextBlock Text="Generate QR code" FontSize="13" Foreground="{StaticResource FluentTextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="4." FontWeight="SemiBold" Foreground="{StaticResource FluentAccent}"/>
                                    <TextBlock Text="Save to desktop" FontSize="13" Foreground="{StaticResource FluentTextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Center - Main Form -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="32">
                <StackPanel Spacing="24" MaxWidth="600">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Create QR Code" FontSize="28" FontWeight="Bold" Foreground="{StaticResource FluentTextPrimary}"/>
                        <TextBlock Text="Generate QR codes from any text or URL" FontSize="14" Foreground="{StaticResource FluentTextSecondary}"/>
                    </StackPanel>

                    <Border Theme="{StaticResource FluentCard}">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Data to Convert" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}"/>
                                <TextBlock Text="Enter the text, URL, or data you want to encode" FontSize="12"
                                           Foreground="{StaticResource FluentTextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Theme="{StaticResource FluentTextBox}" Text="{CompiledBinding ConvertText, Mode=TwoWay}"
                                         Watermark="Enter text or URL..." MaxHeight="150" TextWrapping="Wrap" AcceptsReturn="True"/>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource FluentBorderColor}"/>

                            <StackPanel Spacing="16">
                                <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Filename" FontSize="13" FontWeight="Medium" Foreground="{StaticResource FluentTextPrimary}"/>
                                    <TextBox Theme="{StaticResource FluentTextBox}" Text="{CompiledBinding QRFileName, Mode=TwoWay}" Watermark="my-qrcode"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="File Format" FontSize="13" FontWeight="Medium" Foreground="{StaticResource FluentTextPrimary}"/>
                                    <ComboBox Theme="{StaticResource FluentComboBox}" SelectedItem="{CompiledBinding SelectedFileExtension}" HorizontalAlignment="Stretch">
                                        <x:String>.jpg</x:String>
                                        <x:String>.png</x:String>
                                        <x:String>.bmp</x:String>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource FluentBorderColor}"/>

                            <Grid ColumnDefinitions="*,*" ColumnGap="12">
                                <Button Grid.Column="0" Theme="{StaticResource FluentPrimaryButton}"
                                        Command="{CompiledBinding GenerateAndSaveQRCode}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="✨" FontSize="16"/>
                                        <TextBlock Text="Generate"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Theme="{StaticResource FluentSecondaryButton}"
                                        Command="{CompiledBinding SaveQRFile}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="💾" FontSize="16"/>
                                        <TextBlock Text="Save"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Theme="{StaticResource FluentCard}" Background="#FFF9F0" BorderBrush="#FFE8B3" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="ℹ️" FontSize="16"/>
                                <TextBlock Text="Auto-Generate Enabled" FontSize="13" FontWeight="SemiBold" Foreground="#8B5A00"/>
                            </StackPanel>
                            <TextBlock Text="QR codes are automatically generated as you type (0.5s delay)"
                                       FontSize="12" Foreground="#8B5A00" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Sidebar - History Panel -->
            <Border Grid.Column="2" Background="{StaticResource FluentSidebarBackground}"
                    BorderBrush="{StaticResource FluentBorderColor}" BorderThickness="1,0,0,0" Padding="24">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,20">
                        <TextBlock Text="History" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}"/>
                        <TextBlock Text="Your recently generated QR codes" FontSize="13" Foreground="{StaticResource FluentTextSecondary}"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox Name="ListBox" Items="{CompiledBinding QRCodes}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:QrCode">
                                    <Border Theme="{StaticResource FluentCard}" Padding="16" Margin="0,0,0,12">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{CompiledBinding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FluentTextPrimary}"/>
                                                <TextBlock Text="{CompiledBinding Link}" FontSize="12" Foreground="{StaticResource FluentTextSecondary}"
                                                           TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,*" ColumnGap="8">
                                                <Button Grid.Column="0" Theme="{StaticResource FluentSuccessButton}"
                                                        IsEnabled="{Binding Path=IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}"
                                                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.RegenerateFromHistory}"
                                                        CommandParameter="{Binding ElementName=ListBox, Path=SelectedItem}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                    <TextBlock Text="↻ Load" FontSize="12"/>
                                                </Button>
                                                <Button Grid.Column="1" Theme="{StaticResource FluentDangerButton}"
                                                        IsEnabled="{Binding Path=IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}"
                                                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.DeleteListItem}"
                                                        CommandParameter="{Binding ElementName=ListBox, Path=SelectedIndex}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                    <TextBlock Text="🗑 Delete" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
